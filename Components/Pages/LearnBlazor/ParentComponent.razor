<CascadingValue Value="@MessageForGrandChild">
    <CascadingValue Value="@LuckyNumber" Name="LuckyNumber">
        <_ChildComponent OnButtonClick="ShowMessage" @ref="_ChildComponent" Title="This Title is passed from Parent Component">
    <ChildContent>Some Text between ChildContent from Parent Component</ChildContent>
    <SomeChildContent2>
       <p>This is more detailed content to ChildContent from Parent Component</p>
       <ul>
           <li>Item 1</li>
           <li>Item 2</li>
           <li>Item 3</li>
        </ul>
        </SomeChildContent2>
</_ChildComponent>
</CascadingValue>
</CascadingValue>
<p>@messageText</p>

<button @onclick="CallChildAlert">Show Child Alert</button>


@code {

    private string messageText = "";
    private string MessageForGrandChild = "Hello from Parent Component to Grand Child Component";
    private string LuckyNumber = "7";
    private void ShowMessage()
    {
        messageText = "Button inside child component was clicked";
    }

    private _ChildComponent _ChildComponent;

    private void CallChildAlert()
    {
        _ChildComponent.ToastrSuccess();
    }
}
