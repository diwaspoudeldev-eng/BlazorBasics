@page "/learnrouting"
@page "/learnrouting/{Param1:int}/{Param2}"
@page "/learnrouting/{Param1:int}"
@page "/learnblazor/learnrouting"
@page "/learnrouting/catch-all/{*PageParameters}"

@* No need to set Query Parameter things in Blazor *@

@inject NavigationManager _navigator

<h3>learnrouting</h3>

Parameter1: @Param1

Parameter2: @Param2

Page Parameters: @PageParameters

Query Parameter 3 : @Param3 

Query Parameter 4: @Param4

Using SupplyFromParam : @Param5

<div class="bg-info" style="height:1000px"></div>

<h2 id="targetElement">Main Title</h2>


<div class="row">
    <div class="col-6">
        <a href="/learnrouting?param3=learning&param4=blazor" class="btn btn-primary">Navigate to query Parameter</a>
    </div>

    <div class="col-6">
        <a href="/learnrouting?param3=learning&param4=blazor" class="btn btn-primary">Navigate to query Parameter</a>
    </div>
</div>


<br />
<button @onclick="LoadNavigatation" class="btn btn-primary">Navigate me on URL</button>

<br />
@code {

    [Parameter]
    [SupplyParameterFromQuery(Name = "new")]
    public int Param1 { get; set; } 

    [Parameter]
    public string Param2 { get; set; } = "";

    [Parameter]
    public string Param3 { get; set; } = "";


    [Parameter]
    public string Param4 { get; set; } = "";

    [SupplyParameterFromQuery(Name ="new")]
    public string Param5 { get; set; } = "";

    [Parameter]
    public string PageParameters { get; set; } = string.Empty;

    protected override void OnInitialized()
    {
        var uri = new Uri(_navigator.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        Param3 = query.Get("param3") ?? "";
        Param4 = query.Get("param4") ?? "";
        // _navigator.Refresh(forceReload: true);
    }

    protected  void LoadNavigatation()
    {
        _navigator.NavigateTo("/learnrouting?param3=learning&param4=blazor");
    }

}
